{
  "name": "my-project",
  "version": 1,
  "sources": {
    "include": ["**/*.md", "**/*.txt", "**/*.py", "**/*.ts", "**/*.rs",
                "**/*.json", "**/*.yaml", "**/*.csv"],
    "exclude": ["node_modules/**", "dist/**", ".git/**", "kb/**"]
  },
  "compile": {
    "concept_threshold": 2,
    "max_context_tokens": 200000,
    "incremental": true,
    "batch_size": 10
  },
  "provenance": {
    "required": true,
    "method": "chunk",
    "chunk_strategy": "heading"
  },
  "obsidian": false,
  "output_dir": "kb/output",
  "images": {
    "download": true,
    "max_size_mb": 10
  },
  "impute": {
    "enabled": false,
    "max_searches": 5
  },
  "clipper": {
    "enabled": false,
    "watch_dir": null,
    "auto_ingest": false
  },
  "confidence": {
    "weights": {
      "sources": 0.25,
      "quality": 0.25,
      "recency": 0.25,
      "crossrefs": 0.25
    },
    "decay_tau_days": {
      "code": 90,
      "concept": 365,
      "news": 30,
      "default": 180
    }
  }
}
